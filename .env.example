# Copy to .env and fill in. Never commit .env.
# Not needed until Phase 07 (Google Drive sync) — the app runs fully without them.
# Setup steps will live in docs/google-setup.md.

# OAuth Web client ID (Google Identity Services, scope drive.file only)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# API key for the Google Picker, restricted to the Picker API and your origins
VITE_GOOGLE_API_KEY=your-picker-api-key
